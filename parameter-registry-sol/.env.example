# Deployment Configuration

# === Network RPC URLs ===
# Base Mainnet
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Alternative Base RPC endpoints:
# BASE_MAINNET_RPC_URL=https://base.llamarpc.com
# BASE_MAINNET_RPC_URL=https://base-mainnet.public.blastapi.io

# Base Sepolia Testnet
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# === Block Explorer API Keys ===
# For contract verification on Basescan
BASESCAN_API_KEY=your_basescan_api_key_here

# === Deployment Parameters ===
# Owner address - Has full control of the registry
OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Updater address - Can update parameter values
UPDATER_ADDRESS=0x0000000000000000000000000000000000000000

# === Deployment Method ===
# Set to true to use environment variables for configuration
# Set to false to use hardcoded network-specific configuration in DeployConfig.sol
USE_ENV_CONFIG=false

# Network name (optional, used for logging)
NETWORK_NAME=base-mainnet

# === Wallet Configuration ===
# Option 1: Use a private key directly (NOT RECOMMENDED for mainnet)
# PRIVATE_KEY=0x...

# Option 2: Use a mnemonic phrase
# MNEMONIC="your twelve word mnemonic phrase here for deployment"

# Option 3: Use ETH_FROM with hardware wallet or keystore
# ETH_FROM=0xYourDeployerAddress

# === Gas Configuration (Optional) ===
# Gas price in gwei (optional, will use network default if not set)
# GAS_PRICE=2

# Gas limit (optional, will estimate if not set)
# GAS_LIMIT=3000000

# === Deployment Settings ===
# Verify contract on block explorer after deployment
VERIFY_CONTRACT=true

# Broadcast transaction (set to false for dry run)
BROADCAST=true